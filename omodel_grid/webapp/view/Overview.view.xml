<mvc:View
	controllerName="dhconsulting.fiori.controller.Overview"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:t="sap.ui.table"
	>
	<App id="overview_home">
	<Page title="Sweet Suppliers">
		<Table
			items="{
				path: '/SweetsSupplier'
			}"
		>
			<columns>
				<Column>
					<Text text="Supplier ID" />
				</Column>
				<Column>
					<Text text="Supplier Name" />
				</Column>
			</columns>

			<items>
				<ColumnListItem vAlign="Inherit" type="Navigation" press=".onListItemPress">
					<cells>
						<ObjectIdentifier title="{ID}"/>
						<Text text="{Name}"></Text>
					</cells>
				</ColumnListItem>
			</items>

		</Table>
		
