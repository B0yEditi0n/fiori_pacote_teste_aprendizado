<mvc:View
	controllerName="dhconsulting.fiori.controller.App"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:t="sap.ui.table"
	>
	<App>
	<Page title="Deatil Sweet Suppliers">
		<!-- Tabela do tipo Grid -->
		<t:Table
			rows="{path: '/SweetsSupplier'}"

			threshold="15"
			enableBusyIndicator="true"
			ariaLabelledBy="title"
			paste=".onPaste">

			<t:columns>
				<t:Column 
					sortProperty="Name"
					filterProperty="Name"
					autoResizable="true"
					width="11rem">

					<Label text="Supplier ID" />
					<t:template>
						<Text text="{ID}" wrapping="false" />
					</t:template>

				</t:Column>
				
				<t:Column 
					sortProperty="Name"
					filterProperty="Name"
					autoResizable="true"
					width="11rem">

					<Label text="Supplier Name" />
					<t:template>
						<Text text="{Name}" wrapping="false" />
					</t:template>

				</t:Column>
			</t:columns>
		</t:Table>
		<Breadcrumbs />
	</Page>
	</App>
</mvc:View>