<mvc:View
	controllerName="dhconsulting.fiori.controller.Details"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:t="sap.ui.table"
	>
	<App id="detail">
	<Page 
		title="Deatil Sweet Suppliers"
		showNavButton="true"
        navButtonPress=".onNavBack">

		<Text text="{Name}" />

		<!-- Tabela do tipo Grid -->
		<t:Table
			rows="{path: 'itens>/'}"

			threshold="15"
			enableBusyIndicator="true"
			ariaLabelledBy="title"
			paste=".onPaste">

			<t:columns>
				<t:Column 
					sortProperty="Name"
					filterProperty="Name"
					autoResizable="true"
					width="11rem">

					<Label text="Street" />
					<t:template>
						<Text text="{itens>Street}" wrapping="false" />
					</t:template>

				</t:Column>

				<t:Column 
					sortProperty="Name"
					filterProperty="Name"
					autoResizable="true"
					width="11rem">

					<Label text="City" />
					<t:template>
						<Text text="{itens>City}" wrapping="false" />
					</t:template>

				</t:Column>

				<t:Column 
					sortProperty="Name"
					filterProperty="Name"
					autoResizable="true"
					width="11rem">
					<Label text="State" />
					<t:template>
						<Text text="{itens>State}" wrapping="false" />
					</t:template>
				</t:Column>

				<t:Column 
					sortProperty="Name"
					filterProperty="Name"
					autoResizable="true"
					width="11rem">
					<Label text="ZipCode" />
					<t:template>
						<Text text="{itens>ZipCode}" wrapping="false" />
					</t:template>
				</t:Column>

				<t:Column 
					sortProperty="Name"
					filterProperty="Name"
					autoResizable="true"
					width="11rem">
					<Label text="Country" />
					<t:template>
						<Text text="{itens>Country}" wrapping="false" />
					</t:template>
				</t:Column>
			</t:columns>
		</t:Table>
		<Breadcrumbs />
	</Page>
	</App>
</mvc:View>