{
    "compilerOptions": {
        "skipLibCheck": true,
        "allowJs": true,
        "strict": true,
        "strictPropertyInitialization": false,
        "rootDir": "webapp",
        "target": "es2023",
        "types": ["node", "@types/openui5"],
        "paths": {
            "ui5/walkthrough/*": ["./webapp/*"]
        }
    },
    "include": ["webapp/**/*"]
}