{
	"_version": "1.84.0",
	"start_url": "index.html",
	"sap.app": {
		"id": "dhconsulting.fiori",
		"type": "application",
		"dataSources": {
			"nfeService": {
				"uri": "http://local.dhconsulting.com.br:3000/sap/opu/odata/sap/API_LOGBR_NOTAFISCAL_SRV/",
				"type": "OData",
				"settings": {
					"odataVersion": "2.0",
					"localUri": "/"
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"models": {
			"NFe_API": {
				"dataSource": "nfeService",
				"settings": {}
			}
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"viewPath": "dhconsulting.fiori.view",
				"viewType": "XML",
				"controlId": "root_view",
				"async": true,
				"controlAggregation": "pages"
			},
			"routes": [
				{
					"name": "RouterTableResult",
					"pattern": "SelectTarget",
					"target": "TargetTableResult"
				},
				{
					"name": "RouteMainPage",
					"pattern": "Main",
					"target": "TargetMain"
				}
			],
			"targets": {
				"TargetTableResult": {
					"id": "TableResultPage",
					"viewName": "TableResult"
				},
				"TargetMain": {
					"id": "MainID",
					"viewName": "Main"
				}
			}
		},
		"rootView": {
			"viewName": "dhconsulting.fiori.view.App"
		},
		"flexBundle": false
	}
}