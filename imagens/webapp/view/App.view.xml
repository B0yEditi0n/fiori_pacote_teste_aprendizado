<mvc:View
	controllerName="dhconsulting.fiori.controller.App"
	displayBlock="true"
	xmlns="sap.m"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:l="sap.ui.layout"
	>
	<App>
		<Page title="Titulo">
			<content>
				<VBox>
					<Image src="./assesents/dh-logo.jpeg" width="30em"
						press='.onPressImage'
						load='.onLoadImage'
						error='.onErrorImage'
						tap='.onTapImage'

					></Image>
					<Image src="{img>/imgLogo}" width="100em"></Image>
					<!-- Teste de  inclusão dinamica -->
					<HBox id="hbox_content"></HBox>
					<!-- Teste de  inclusão dinamica -->

					<!-- ###################### -->
					<!-- # Utilização de Grid # -->
					<!-- ###################### -->
					<l:VerticalLayout
							width="100%"
							class="gridWrapper">
						<l:Grid
								containerQuery="true"
								hSpacing="0">
							<core:HTML content="&lt;div class=&quot;exampleDiv&quot; /&gt;" />
							<core:HTML content="&lt;div class=&quot;exampleDiv contrastColor&quot; /&gt;" />
							<core:HTML content="&lt;div class=&quot;exampleDiv&quot; /&gt;" />
							<core:HTML content="&lt;div class=&quot;exampleDiv contrastColor&quot; /&gt;" />
						</l:Grid>
					</l:VerticalLayout>

				</VBox>
			</content>
		</Page>
	</App>
</mvc:View>